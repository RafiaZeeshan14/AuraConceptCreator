# `lightswind` (used for its Tailwind plugin and generated components) declares
# stale *optional* peer ranges that this project intentionally exceeds:
#   framer-motion: ^10 || ^11 || ^12   -> project uses 13.x
#   tailwind-merge: ^2.6.1             -> project uses 3.x
# npm 7+ enforces peer ranges, so a clean `npm install` (as run by Vercel)
# aborts with ERESOLVE even though the app never touches those optional peers.
# Installing with legacy peer resolution keeps the lockfile stable on Vercel.
legacy-peer-deps=true